# This template is used by GitHub Actions to inject secrets from 1Password
# OP_VAULT is set dynamically by the workflow based on the branch (dev/prod)
DATABASE_URL="op://${OP_VAULT}/Database/connection_string"
SESSION_SECRET="op://${OP_VAULT}/App/session_secret"
HOST="op://${OP_VAULT}/CapRover/url"
# App's own public URL (86e2v1bbr) -- better-auth's baseURL, NOT the CapRover
# management URL above (HOST). Confirm at install time that the env var name
# here matches whatever better-auth's config actually reads (e.g. it may
# expect BETTER_AUTH_URL specifically) -- rename this line's left-hand side
# to match, the op:// reference itself does not need to change.
APP_URL="op://${OP_VAULT}/CapRover/app_url"