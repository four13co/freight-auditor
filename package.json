{
  "name": "freight-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "worker:start": "node dist/worker/index.js",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:metrics": "node dist/worker/metrics.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --dir test/e2e",
    "test:db": "vitest run --config vitest.db.config.ts",
    "web:test": "npm --prefix web run test",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:e2e": "npm --prefix web run test:e2e",
    "web:e2e:fullstack": "npm --prefix web run test:e2e:fullstack",
    "web:e2e:fullstack-auth": "npm --prefix web run test:e2e:fullstack-auth",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate-with-retry.mjs",
    "seed:dev": "node scripts/seed-dev-tenant.mjs",
    "seed:criteria": "tsx scripts/seed-criteria.mjs",
    "seed:e2e-fullstack-fixture": "tsx scripts/seed-fullstack-e2e-fixture.mjs",
    "seed:e2e-auth-user": "tsx scripts/seed-e2e-auth-user.mjs",
    "seed:e2e-portal-user": "tsx scripts/seed-e2e-portal-user.mjs",
    "seed:admin": "tsx scripts/seed-admin-user.mjs",
    "r2:bucket:list": "wrangler r2 bucket list",
    "dev:fullstack-server": "PORT=4180 DEV_AUTH_HEADERS=1 tsx src/server/index.ts",
    "dev:fullstack-auth-server": "PORT=4181 tsx src/server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@better-auth/passkey": "^1.7.1",
    "@fastify/static": "^10.1.3",
    "better-auth": "^1.7.1",
    "decimal.js": "^10.4.3",
    "exceljs": "4.4.0",
    "fastify": "^5.12.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "ssh2-sftp-client": "^12.1.1",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "js-yaml": "^5.2.3",
    "node-pg-migrate": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.126.0"
  }
}
