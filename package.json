{
  "name": "freight-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --dir test/e2e",
    "test:db": "vitest run --config vitest.db.config.ts",
    "web:test": "npm --prefix web run test",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:e2e": "npm --prefix web run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate-with-retry.mjs",
    "seed:dev": "node scripts/seed-dev-tenant.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "decimal.js": "^10.4.3",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "js-yaml": "^5.2.3",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
