# Deployed app's public URL via 1Password reference (safe to commit — a reference, not a
# value). Used by the post-deployment workflow job's health-check poll:
#   op run --env-file=.env.post-deploy -- node scripts/post-deploy-healthcheck.mjs
# so APP_URL is injected into that one subprocess env only — never written to $GITHUB_ENV
# or disk as plaintext.
#
# NOTE: distinct from CapRover/url in .env.caprover (that's the CapRover admin API host used
# to trigger builds; this is the deployed app's own public URL that /health is polled on). A
# human must populate this 1Password field before the post-deployment job can pass.
APP_URL="op://${OP_VAULT}/CapRover/app_url"
