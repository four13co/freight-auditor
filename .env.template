# This template is used by GitHub Actions to inject secrets from 1Password
# OP_VAULT is set dynamically by the workflow based on the branch (dev/prod)
DATABASE_URL="op://${OP_VAULT}/Database/connection_string"
SESSION_SECRET="op://${OP_VAULT}/App/session_secret"
HOST="op://${OP_VAULT}/CapRover/url"
# HOST above is read by nothing in src/ or scripts/ (see 86e2v1xwh -- open
# decision: document-and-keep vs. remove). Do not treat this comment as
# resolving that question either way.
#
# App's own public URL (86e2v1bbr) -- better-auth's baseURL, a DIFFERENT
# value from HOST (which is the CapRover admin/management host, consumed
# via .env.caprover's SRC_CAPROVER_URL, not this file). Same op:// reference
# .env.post-deploy already uses for its health-check poll (established
# precedent, not invented here). Confirm at install time that the env var
# name on the left matches whatever better-auth's config actually reads
# (e.g. it may expect BETTER_AUTH_URL specifically) -- rename this line's
# left-hand side to match; the op:// reference itself does not need to
# change. PREREQUISITE: this 1Password item is confirmed populated in the
# dev vault only -- a Production deploy needs the equivalent CapRover/app_url
# entry created in the prod vault first, or this line will fail the same
# way .env.post-deploy's own comment already flags for its copy.
APP_URL="op://${OP_VAULT}/CapRover/app_url"