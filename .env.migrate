# DATABASE_URL via 1Password reference (safe to commit — a reference, not a value). Used by
# the migrate-database workflow job:
#   op run --env-file=.env.migrate -- bash -c 'node scripts/guard-protected-db.mjs && npm run migrate up'
# so DATABASE_URL is injected into that one subprocess env only — never written to $GITHUB_ENV
# or disk as plaintext.
DATABASE_URL="op://${OP_VAULT}/Database/connection_string"

# SESSION_SECRET/APP_URL + ADMIN_PASSWORD: only needed when SEED_ADMIN_ENABLED=1 runs
# npm run seed:admin in this same job (scripts/seed-admin-user.mjs, via getAuth()) --
# resolved unconditionally here (op run resolves every reference in the file up front)
# but only actually used by that conditional step, same pattern as seed:dev above it.
SESSION_SECRET="op://${OP_VAULT}/App/session_secret"
APP_URL="op://${OP_VAULT}/CapRover/app_url"
ADMIN_PASSWORD="op://${OP_VAULT}/App/admin_password"

# The on/off switch for the seed:admin step itself, deliberately a 1Password
# value rather than a `gh variable` -- Greg's call: keep every deploy-time
# toggle for this feature in one place (the vault) instead of split across
# 1Password and GitHub repo settings. "1" enables; unset/anything else
# disables. The Development-vs-Production branch exclusion stays a hard
# `github.ref_name` check in deploy.yml itself (86e2v24uf's guarantee), NOT
# something this value can override -- this only controls the opt-in half.
SEED_ADMIN_ENABLED="op://${OP_VAULT}/App/seed_admin_enabled"
