# CapRover deploy credentials via 1Password references (safe to commit — references, not
# values). Used by the deploy workflow's final step:
#   op run --env-file=.env.caprover -- caprover deploy ...
# so these are injected into that one subprocess env only — never written to $GITHUB_ENV or
# disk as plaintext.
#
# Named SRC_CAPROVER_URL/SRC_CAPROVER_APP_TOKEN, not CAPROVER_URL/CAPROVER_APP_TOKEN: the
# caprover CLI itself reads CAPROVER_URL from its environment as a fallback for --caproverUrl,
# and when that env var is set to the *same* value being interpolated into the --caproverUrl
# flag, the CLI's own precedence logic clobbers it, producing "https://." instead of the real
# URL. Using a differently-named source var avoids the collision entirely.
SRC_CAPROVER_URL="op://${OP_VAULT}/CapRover/url"
SRC_CAPROVER_APP_TOKEN="op://${OP_VAULT}/CapRover/app_token"
SRC_CAPROVER_APP_NAME="op://${OP_VAULT}/CapRover/app_name"
