# CapRover deploy credentials via 1Password references (safe to commit — references, not
# values). Used by the deploy workflow's final step:
#   op run --env-file=.env.caprover -- <curl deploy command>
# so CAPROVER_URL/CAPROVER_APP_TOKEN are injected into that one subprocess env only — never
# written to $GITHUB_ENV or disk as plaintext.
CAPROVER_URL="op://${OP_VAULT}/CapRover/url"
CAPROVER_APP_TOKEN="op://${OP_VAULT}/CapRover/app_token"
